Notebook[{

Cell[CellGroupData[{
Cell["Euler elastica", "Title",
 CellChangeTimes->{{3.718789239736045*^9, 3.7187892432524447`*^9}}],

Cell["Data", "Subtitle",
 CellChangeTimes->{{3.718789249237818*^9, 3.7187892498005257`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"E1", "=", 
   RowBox[{"75", "*", 
    RowBox[{"10", "^", "9"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.718783048775973*^9, 3.718783102893061*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"J", "=", 
   RowBox[{
    RowBox[{"0.005", "^", "4"}], "/", "12"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7187831085347753`*^9, 3.7187831089098043`*^9}, {
  3.7187831631993885`*^9, 3.7187831773709717`*^9}, {3.71878322380031*^9, 
  3.718783249069898*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "=", "0.5"}], ";"}]], "Input",
 CellChangeTimes->{{3.718783194717552*^9, 3.7187832144082317`*^9}}],

Cell[CellGroupData[{

Cell["Critical buckling load", "Subtitle",
 CellChangeTimes->{{3.7187892568291245`*^9, 3.7187892613829603`*^9}}],

Cell[BoxData[
 RowBox[{"Pcr", "=", 
  RowBox[{"E1", "*", "J", "*", 
   RowBox[{
    RowBox[{
     RowBox[{"Pi", "^", "2"}], "/", 
     RowBox[{"L", "^", "2"}]}], "/", "4"}]}]}]], "Input",
 CellChangeTimes->{{3.71878326763527*^9, 3.7187833216125975`*^9}}]
}, Open  ]],

Cell[CellGroupData[{

Cell["Nonlinear solution", "Subtitle",
 CellChangeTimes->{{3.7187892845263195`*^9, 3.7187892869018383`*^9}}],

Cell["\<\
Evaluation of the elliptic integral and load/deflection values for \
0<\[Alpha]<120deg\
\>", "Subsubtitle",
 CellChangeTimes->{{3.7187892899198914`*^9, 3.7187893582989626`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"XY", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Reap", "[", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"i", "=", "0"}], ",", 
        RowBox[{"i", "\[LessEqual]", "100"}], ",", 
        RowBox[{
         RowBox[{"i", "++"}], ";", "\[IndentingNewLine]", 
         RowBox[{"alpha", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"i", "/", "100"}], ")"}], "*", 
           RowBox[{"2", "/", "3"}], "*", "Pi"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"rhosq", "=", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"Sin", "[", 
             RowBox[{"alpha", "/", "2"}], "]"}], ")"}], "^", "2"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"K", "=", 
          RowBox[{"EllipticK", "[", "rhosq", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"k", "=", 
          RowBox[{"K", "/", "L"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"P", "=", 
          RowBox[{
           RowBox[{"k", "^", "2"}], "*", "E1", "*", "J"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"y", "=", 
          RowBox[{"2", "*", 
           RowBox[{
            RowBox[{"Sqrt", "[", "rhosq", "]"}], "/", "k"}]}]}], ";", 
         RowBox[{"Sow", "[", 
          RowBox[{"y", "/", "L"}], "]"}], ";", 
         RowBox[{"Sow", "[", 
          RowBox[{"P", "/", "Pcr"}], "]"}]}]}], "]"}], "]"}], "[", 
     RowBox[{"[", 
      RowBox[{"2", ",", "1"}], "]"}], "]"}], "~", "Partition", "~", "2"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.718787213639619*^9, 3.718787265989027*^9}, {
  3.7187872964570303`*^9, 3.718787379300873*^9}, {3.718787417080842*^9, 
  3.7187874806505537`*^9}, {3.7187875173032684`*^9, 3.7187875422369013`*^9}, {
  3.718787606671214*^9, 3.7187876079840527`*^9}, {3.718787804196477*^9, 
  3.7187878146313267`*^9}, {3.7187881044747763`*^9, 3.7187881102101526`*^9}, {
  3.718788166439141*^9, 3.7187881768470774`*^9}, {3.7187888531863556`*^9, 
  3.7187888763081336`*^9}, {3.7187889168026795`*^9, 3.7187889199438615`*^9}, {
  3.7187889968880625`*^9, 3.718789001920372*^9}, {3.718789077754466*^9, 
  3.718789079879898*^9}}],

Cell[BoxData[
 RowBox[{"%", "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.718787816897296*^9, 3.7187878203257737`*^9}}],

Cell[CellGroupData[{

Cell["\<\
Nonlinear equilibrium of the buckled bar\
\>", "Subsubtitle",
 CellChangeTimes->{{3.7187893796206007`*^9, 3.7187894034686537`*^9}}],

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", "XY", "}"}], ",", 
   RowBox[{"Joined", "\[Rule]", "True"}], ",", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0.9"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "2"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\"\<y(L)/L\>\"", ",", "\"\<P/Pcr\>\""}], "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.718787761397826*^9, 3.718787791675943*^9}, {
  3.7187878283270473`*^9, 3.718787864679715*^9}, {3.71878795140583*^9, 
  3.718787973327626*^9}, {3.718788003813796*^9, 3.7187880086737223`*^9}, {
  3.718788046551332*^9, 3.7187880951289043`*^9}, {3.7187882614774323`*^9, 
  3.718788411396509*^9}, {3.7187884837859097`*^9, 3.7187885150725064`*^9}, {
  3.718789019476777*^9, 3.718789037890397*^9}, {3.7187890901783295`*^9, 
