 CellChangeTimes->{3.9187351225769825`*^9},
 CellLabel->"In[39]:=",ExpressionUUID->"cff5c787-f4f1-b144-80f1-bcb39c52acb5"],

Cell[TextData[{
 "We suppose here to write the equations with different constrained point. \
Previously, the center of the circle was constrained. Now we consider the \
support to be placed in the bottom-right corner (bottom left in the mirrored \
figure above), with ",
 Cell[BoxData[
  StyleBox[
   RowBox[{"\[Alpha]", "=", 
    RowBox[{"26", " ", "deg"}]}],
   FontWeight->"Bold"]], "InlineCode",ExpressionUUID->
  "9e95b332-ce7c-9c48-a784-0e240251a93a"],
 " (0.45 rad), at the initial distance of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["r", "0"]}], "/", 
      RowBox[{"Tan", "(", "\[Alpha]", ")"}]}], ",", " ", 
     StyleBox[
      SubscriptBox["r", "0"],
      FontWeight->"Bold"]}], 
    StyleBox[")",
     FontWeight->"Bold"]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"1de2cb6b-67ae-044e-92f7-81f67f900e21"],
 ", so as to have the new ref. frame defined as: ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["x", "2"], "=", 
    RowBox[{"x", "-", 
     RowBox[{"Int", "(", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "'"}], " ", "/", 
        RowBox[{"Tan", "(", "\[Alpha]", ")"}]}], " ", "dt"}], ")"}]}]}], 
   TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"3719916e-07f6-1749-a7bd-35c51eb6d65c"],
 " ",
 StyleBox["- ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["r", "0"], "/", 
    RowBox[{"Tan", "(", "\[Alpha]", ")"}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"eaded260-d0b0-5949-91b7-9cf0a872e3a1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["y", "2"], "=", 
    RowBox[{"y", " ", "+", " ", 
     RowBox[{"Int", "(", "r"}]}]}], TraditionalForm]],
  FontWeight->"Bold",ExpressionUUID->"98536e60-4d3b-2b4b-84f7-1853d0e76c60"],
 StyleBox["\[CloseCurlyQuote]dt) + ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   StyleBox[
    SubscriptBox["r", "0"],
    FontWeight->"Bold"], TraditionalForm]],ExpressionUUID->
  "dd33eaf0-d593-7742-a765-e18319649c58"],
 ". %Data extracted from the experimental results.%"
}], "Text",
 CellChangeTimes->{{3.918469906680134*^9, 3.918470068376534*^9}, {
