Cell[TextData[{
 "The tape tip displacement can be obtained by rotating the original ref \
frame of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Theta]", "0"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "5e592006-65e0-7f4c-861b-b2d5330b27cc"],
 " (assuming the bottom point of the circle is fixed)."
}], "Text",
 CellChangeTimes->{{3.9184906764230213`*^9, 
  3.9184907397501335`*^9}},ExpressionUUID->"5705627a-109d-bc4b-b985-\
9bb62442dd14"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[Theta]", "0"], "=", 
   RowBox[{
    RowBox[{"-", "\[Pi]"}], "/", "2"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9184905435711346`*^9, 3.918490557596218*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"37af502d-bd1e-3a4d-af07-90cbf6f50c31"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"r", "[", "t", "]"}], " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{
          FractionBox["l", 
           RowBox[{"r", "[", "t", "]"}]], "-", 
          SubscriptBox["\[Theta]", "0"]}], "]"}], ",", 
        RowBox[{"Cos", "[", 
         RowBox[{
          FractionBox["l", 
           RowBox[{"r", "[", "t", "]"}]], "-", 
          SubscriptBox["\[Theta]", "0"]}], "]"}]}], "}"}]}], "/.", 
     "\[VeryThinSpace]", "initData"}], "/.", "\[VeryThinSpace]", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tBlossom"}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Web\>\""}]}], "]"}]], "Input",
