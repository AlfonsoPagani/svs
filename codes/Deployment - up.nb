Cell[CellGroupData[{

Cell["Effect of friction", "Section",
 CellChangeTimes->{{3.918491603875391*^9, 3.918491607430641*^9}, {
  3.918491654052761*^9, 
  3.9184916602167206`*^9}},ExpressionUUID->"ad4b294f-d853-234d-b48b-\
f7eb736d1fa9"],

Cell[CellGroupData[{

Cell["Friction dissipation energy", "Subsection",
 CellChangeTimes->{{3.9184916644928665`*^9, 
  3.9184916690625496`*^9}},ExpressionUUID->"a9212fe0-ecc8-2347-a4a5-\
472b3a76a2d8"],

Cell[TextData[{
 "The normal force is assumed to be equal to the centrifugal force difference \
between outer layer and inner layer. In essence, we have ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["F", "N"], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "m"}], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[Theta]", "\[Prime]",
        MultilineFunction->None], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["r", "in"], "-", 
       SubscriptBox["r", "out"]}], ")"}]}], "=", 
    RowBox[{"m", " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["\[Theta]", "\[Prime]",
        MultilineFunction->None], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox["r", "max"], "/", "r"}], ")"}], "h"}]}]}]],ExpressionUUID->
  "512df29b-3370-cc41-928c-ead16f9047a3"],
 ", where: ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["r", "max"], "=", 
   RowBox[{
    RowBox[{"l", "/", "2"}], "\[Pi]"}]}]],ExpressionUUID->
  "3fa4fc16-b1a9-fc42-b309-329f03f67e59"],
 ", ",
 Cell[BoxData[
  RowBox[{
   SubscriptBox["r", "max"], "/", "r"}]],ExpressionUUID->
  "3f23487e-e28b-1348-9bb5-77c065f85961"],
 " is the number of overlapping revolutions and ",
 Cell[BoxData[
 "h"], "InlineCode",ExpressionUUID->"cfb36d8b-c660-ff46-a9a4-3d73bfb941b1"],
 " is the tape thickness."
}], "Text",
 CellChangeTimes->{{3.91849202105583*^9, 3.918492048899788*^9}, {
  3.918556190533304*^9, 3.91855646724481*^9}, {3.918789193460794*^9, 
  3.918789203321861*^9}, {3.918789247124544*^9, 
  3.9187892621260242`*^9}},ExpressionUUID->"0ca03050-1e66-c04c-83d3-\
a6e36f4cd7a4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  SubscriptBox["F", "N"], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Rho]", " ", "l", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Theta]", "'"}], "[", "t", "]"}], "^", "2"}], " ", 
     RowBox[{
      SubscriptBox["r", "max"], "/", 
      RowBox[{"r", "[", "t", "]"}]}], " ", "h"}], "/.", 
    RowBox[{
     RowBox[{
      SuperscriptBox["\[Theta]", "\[Prime]",
       MultilineFunction->None], "[", "t", "]"}], "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{"l", " ", 
        RowBox[{
         SuperscriptBox["r", "\[Prime]",
          MultilineFunction->None], "[", "t", "]"}]}], 
       SuperscriptBox[
        RowBox[{"r", "[", "t", "]"}], "2"]]}]}]}], " ", "/.", 
   RowBox[{
