Cell[BoxData[
 RowBox[{"ParametricPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "t", "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{
            FractionBox["l", 
             RowBox[{"r", "[", "t", "]"}]], "-", 
            SubscriptBox["\[Theta]", "0"]}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"r", "[", "t", "]"}], "-", 
            RowBox[{"r", "[", "0", "]"}]}], ")"}], "/", 
          RowBox[{"Tan", "[", "0.45", "]"}]}], " ", "-", 
         RowBox[{
          RowBox[{"r", "[", "0", "]"}], "/", 
          RowBox[{"Tan", "[", "0.45", "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "t", "]"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{
            FractionBox["l", 
             RowBox[{"r", "[", "t", "]"}]], "-", 
            SubscriptBox["\[Theta]", "0"]}], "]"}]}], "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"r", "[", "t", "]"}], "-", 
           RowBox[{"r", "[", "0", "]"}]}], ")"}], "+", 
         RowBox[{"r", "[", "0", "]"}]}]}], "}"}], "/.", "\[VeryThinSpace]", 
      "initData3"}], "/.", "\[VeryThinSpace]", "sol3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "tBlossom3"}], "}"}], ",", 
   RowBox[{"PlotTheme", "\[Rule]", "\"\<Web\>\""}]}], "]"}]], "Input",
