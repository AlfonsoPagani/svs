Cell[CellGroupData[{

Cell["Effect of air drag dissipation", "Section",
 CellChangeTimes->{{3.9184048562274475`*^9, 
  3.9184048644742355`*^9}},ExpressionUUID->"56c9885a-f989-2548-804c-\
11d176edb158"],

Cell[CellGroupData[{

Cell["Air drag dissipation function and drag force", "Subsection",
 CellChangeTimes->{{3.9184049293216724`*^9, 3.9184049353058963`*^9}, {
  3.918453687604395*^9, 
  3.918453693026024*^9}},ExpressionUUID->"09639bd5-10f7-7a4b-9213-\
c4c077138a4d"],

Cell[TextData[{
 "It is assumed here that ",
 StyleBox["drag is due to normal flow on the tape surface during the \
blossoming",
  FontVariations->{"Underline"->True}],
 ". Tangential velocity is not affecting drag. Also, the wet area is not \
constant (",
 StyleBox["A=b\[Times]l",
  FontWeight->"Bold"],
 "), but proportional to ",
 StyleBox["r",
  FontWeight->"Bold"],
 "; i.e. ",
 StyleBox["A=2\[Pi]\[Times]r[t]\[Times]b ",
  FontWeight->"Bold"],
 "to have:"
}], "Text",
 CellChangeTimes->{{3.918409829583908*^9, 3.918409978198723*^9}, {
  3.9184533139914203`*^9, 
  3.91845331868326*^9}},ExpressionUUID->"9cf7affa-e2d4-0745-8e04-\
e329b590a29a"],

