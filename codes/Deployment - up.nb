Cell[TextData[{
 "In the following, ",
 StyleBox["tBlossom",
  FontWeight->"Bold"],
 " is the time at which ",
 StyleBox["r[t] ",
  FontWeight->"Bold"],
 "is exactly equal to ",
 StyleBox["l/2\[Pi]",
  FontWeight->"Bold"],
 ". At ",
 StyleBox["t=tBlossom",
  FontWeight->"Bold"],
 ", we have a perfect circle with no overlapping. From this moment on, the \
tape will deploy as an hinge."
}], "Text",
 CellChangeTimes->{{3.918402486925621*^9, 
